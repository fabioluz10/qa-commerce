{
  "name": "qa-commerce",
  "version": "1.0.0",
  "description": "Projeto de simulação de aulas de QA",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "db": "node scripts/init_db.js",
    "pretest:e2e": "npm-run-all db allure:clear",
    "test:e2e": "start-server-and-test start http://127.0.0.1:3000/api/produtos \"npm-run-all --continue-on-error cypress:run allure:generate\"",
    "test:e2e:open": "npm-run-all --continue-on-error test:e2e allure:open",
    "cypress:run": "cypress run",
    "cypress:run:api": "cypress run --spec \"cypress/e2e/api/**/*.feature\"",
    "cypress:run:web": "cypress run --spec \"cypress/e2e/web/**/*.feature\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:clear": "rimraf allure-results allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.5.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "express": "^4.21.2",
    "faker": "^6.6.6",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "open": "^10.1.0",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "allure-commandline": "^2.34.1",
    "allure-cypress": "^3.10.2",
    "cypress": "^15.20.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "start-server-and-test": "^3.0.12"
  }
}
